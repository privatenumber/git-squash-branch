{
	"name": "git-squash-branch",
	"version": "0.0.0-semantic-release",
	"description": "Squash commits in a Git branch or pull-request",
	"keywords": [
		"git",
		"squash",
		"branch"
	],
	"license": "MIT",
	"repository": "privatenumber/git-squash-branch",
	"funding": "https://github.com/privatenumber/git-squash-branch?sponsor=1",
	"author": {
		"name": "Hiroki Osame",
		"email": "hiroki.osame@gmail.com"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"bin": "dist/index.mjs",
	"packageManager": "pnpm@10.33.2",
	"scripts": {
		"prepare": "simple-git-hooks",
		"build": "pkgroll --clean-dist --minify --target=node22.22",
		"lint": "lintroll",
		"test": "pnpm build && tsx tests",
		"type-check": "tsc --noEmit",
		"prepack": "pnpm build && clean-pkg-json"
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm exec lintroll --staged"
	},
	"engines": {
		"node": ">=22.22.2"
	},
	"dependencies": {
		"tasuku": "3.0.0-beta.5",
		"terminal-link": "5.0.0"
	},
	"devDependencies": {
		"@clack/prompts": "^1.7.0",
		"@types/node": "^24.13.3",
		"@types/prompts": "^2.4.2",
		"ansis": "^4.3.1",
		"clean-pkg-json": "^1.2.0",
		"cleye": "3.0.0-beta.1",
		"fs-fixture": "^1.2.0",
		"lintroll": "^1.31.1",
		"manten": "^0.6.1",
		"nano-spawn": "^2.1.0",
		"pkgroll": "^2.27.1",
		"semantic-release": "^25.0.9",
		"simple-git-hooks": "^2.8.1",
		"tsx": "^4.23.12",
		"typescript": "^5.9.3"
	}
}
